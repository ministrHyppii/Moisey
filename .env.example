# Скопируйте этот файл в .env и вставьте токен бота (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=
# Владелец бота с неограниченными командами (по умолчанию уже указан ваш ID)
OWNER_ID=1012623951719051284
# Необязательно: ID тестового сервера — слэш-команды появятся на нём мгновенно
DEV_GUILD_ID=
# Необязательно: путь к базе данных
DB_PATH=data/modbot.db
